// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


// 1. Configuration du Provider (sqlite) - utilisez une base de données locale pour le développement
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


// 2. Modèle Utilisateur (pour l'authentification)
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Le mot de passe HACHÉ
  name      String?
  articles  Article[]   // Relation : Un utilisateur peut avoir plusieurs articles

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 3. Modèle Article de Blog
model Article { // J'utilise 'Article' au lieu de 'Post' pour mieux correspondre à votre JSON
  id        Int      @id @default(autoincrement())
  // Champs pour les données simples et l'indexation
  uniqueId  String   @unique // Utilisé pour le "1" dans votre JSON original
  date      DateTime
  author    String
  
  // Le champ qui va contenir toutes les données françaises (fr) et anglaises (en)
  // Utilisation du type Json pour stocker la structure complexe du contenu de l'article.
  contentFr Json     @map("content_fr") // Mappe à une colonne 'content_fr'
  contentEn Json?    @map("content_en") // contentEn est optionnel

  // Référence à l'auteur
  authorUser User @relation(fields: [authorId], references: [id])
  authorId   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("articles") // Le nom de la table sera 'articles'
}

// 4.Modèle pour les tags utilisés dans les articles
model Tag {
  id        Int      @id @default(autoincrement())
  slug      String   // ex: "web-app", "fintech"
  label     String   // ex: "Web app", "FinTech"
  href      String   // ex: "/blog?tags=web-app"
  category  String   // "projectType" ou "industry"
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optionnel : Si vous voulez lier des articles à des tags plus tard
  // articles Article[] 
}