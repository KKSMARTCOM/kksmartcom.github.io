// SQLite en local — pour la production, remplacer provider par "postgresql"
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  name      String?
  role      String     @default("ADMIN")
  articles  Article[]
  blogPosts BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Article {
  id        Int      @id @default(autoincrement())
  uniqueId  String   @unique
  date      DateTime
  author    String
  contentFr Json     @map("content_fr")
  contentEn Json?    @map("content_en")
  authorUser User  @relation(fields: [authorId], references: [id])
  authorId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("articles")
}

model Tag {
  id        Int      @id @default(autoincrement())
  slug      String
  label     String
  href      String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Carrières ───────────────────────────────────────────────

model JobOffer {
  id               Int       @id @default(autoincrement())
  slug             String    @unique
  status           String    @default("draft")
  titleFr          String
  titleEn          String?
  descriptionFr    String
  descriptionEn    String?
  location         String?
  contractType     String?
  department       String?
  applicationEmail String?
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ─── Services ────────────────────────────────────────────────

model ServiceCategory {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  order     Int       @default(0)
  titleFr   String
  titleEn   String?
  services  Service[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Service {
  id             Int             @id @default(autoincrement())
  slug           String          @unique
  categoryId     Int
  category       ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order          Int             @default(0)
  titleFr        String
  titleEn        String?
  descriptionFr  String?
  descriptionEn  String?
  href           String          @default("#")
  imageUrl       String?
  imageAltFr     String?
  imageAltEn     String?
  isPublished    Boolean         @default(true)
  showInNav      Boolean         @default(true)
  showOnHomepage Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// ─── Blog éditorial (phase 4) ─────────────────────────────────

model BlogDepartment {
  id            Int               @id @default(autoincrement())
  slug          String            @unique
  order         Int               @default(0)
  nameFr        String
  nameEn        String?
  subcategories BlogSubcategory[]
  posts         BlogPost[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model BlogSubcategory {
  id           Int            @id @default(autoincrement())
  slug         String         @unique
  departmentId Int
  department   BlogDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  order        Int            @default(0)
  nameFr       String
  nameEn       String?
  posts        BlogPost[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model BlogPost {
  id              Int              @id @default(autoincrement())
  slug            String           @unique
  status          String           @default("draft")
  departmentId    Int?
  department      BlogDepartment?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  subcategoryId   Int?
  subcategory     BlogSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  authorId        Int
  author          User             @relation(fields: [authorId], references: [id])
  titleFr         String
  titleEn         String?
  summaryFr       String?
  summaryEn       String?
  introductionFr  String?
  introductionEn  String?
  bodyFr          String?
  bodyEn          String?
  conclusionFr    String?
  conclusionEn    String?
  sectionsFr      Json?
  sectionsEn      Json?
  coverImage      String?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}
